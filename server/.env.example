# Copy to server/.env. Without any key, the app still runs using the
# rule-based heuristic fallback (insights are badged "heuristic" in the UI).

# --- Option 1: Google Gemini ---
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=...

# --- Option 2: Anthropic Claude ---
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# Optional
# PORT=3001
